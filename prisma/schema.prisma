datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = []
}

model Asset {
  id            String   @id @default(uuid())
  organizationId String  // Logical Link (just a string, NO @relation)
  url           String   // S3/R2 URL or storage path
  fileName      String?
  mimeType      String?
  fileSize      Int?     // Size in bytes
  aiDescription String?  @db.Text // Generated by Vision Model
  // embedding   Unsupported // pgvector - would need extension, omitted for now
  metadata      Json?    // Additional asset metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("editor_assets")
  @@index([organizationId])
  @@index([url])
}

model EditorProject {
  id            String   @id @default(uuid())
  organizationId String  // Logical Link (just a string, NO @relation)
  name          String
  description   String?  @db.Text
  schema        Json     // The page/component tree structure
  isPublished   Boolean  @default(false)
  metadata      Json?    // Additional project metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations within the same package
  generations GenerationHistory[]

  @@map("editor_projects")
  @@index([organizationId])
  @@index([isPublished])
}

model GenerationHistory {
  id            String   @id @default(uuid())
  organizationId String  // Logical Link (just a string, NO @relation)
  projectId     String?  // Logical Link to EditorProject (just a string, NO @relation)
  prompt        String   @db.Text
  response      Json?    // Structured component JSON response
  model         String?  // LLM model used (e.g., "gpt-4", "gpt-4o")
  tokensUsed    Int?
  componentId   String?  // The data-component-id that was edited
  metadata      Json?    // Additional generation metadata
  createdAt     DateTime @default(now())

  @@map("editor_generation_history")
  @@index([organizationId])
  @@index([projectId])
  @@index([createdAt])
}

model PromptHistory {
  id            String   @id @default(uuid())
  organizationId String  // Logical Link (just a string, NO @relation)
  prompt        String   @db.Text
  response      String?  @db.Text
  model         String?  // LLM model used (e.g., "gpt-4", "claude-3")
  tokensUsed    Int?
  metadata      Json?    // Additional generation metadata
  // productId   String?  // Logical Link to commerce Product (just a string, NO @relation)
  // embedding   Unsupported("pgvector") // Vector embedding for semantic search (1536 dimensions for text-embedding-3-small)
  // Note: pgvector requires raw SQL queries. Use Prisma.$queryRaw for vector operations.
  embeddingGenerated Boolean @default(false) // Track if embedding has been generated
  createdAt     DateTime @default(now())

  @@map("editor_prompt_history")
  @@index([organizationId])
  @@index([createdAt])
  @@index([embeddingGenerated])
}


